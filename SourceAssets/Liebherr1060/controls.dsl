(event EventBeginPlay
  (bind controller (Game|GetPlayerController 0))
  (Input|EnableInput :PlayerController controller)
  (Game|Player|SetViewTargetwithBlend :self controller :NewViewTarget (Variables|Getareferencetoself) :BlendTime 0.25))

(event EventTick (DeltaSeconds)
  (bind controller (Game|GetPlayerController 0))
  (if (Math|Boolean|NOTBoolean (Variables|Default|GetControlsReady))
    (CallFunction|AcquireControls))
  (if ("Utilities|Operators|Equal(==)" (Pawn|GetViewTarget :self controller) (Variables|Getareferencetoself))
  (bind step ("Math|Float|Clamp(Float)" DeltaSeconds 0.0 0.1))
  (bind drive (Utilities|Operators|Subtract (Math|Float|SelectFloat 1.0 0.0 (Game|Player|IsInputKeyDown :self controller :Key "W")) (Math|Float|SelectFloat 1.0 0.0 (Game|Player|IsInputKeyDown :self controller :Key "S"))))
  (bind steer (Utilities|Operators|Subtract (Math|Float|SelectFloat 1.0 0.0 (Game|Player|IsInputKeyDown :self controller :Key "D")) (Math|Float|SelectFloat 1.0 0.0 (Game|Player|IsInputKeyDown :self controller :Key "A"))))
  (CallFunction|SteerTruck :DeltaSeconds step :Axis steer :DriveAxis drive)
  (CallFunction|DriveTruck :DeltaSeconds step :Axis drive)
  (bind lift (Utilities|Operators|Subtract (Math|Float|SelectFloat 1.0 0.0 (Game|Player|IsInputKeyDown :self controller :Key "Down")) (Math|Float|SelectFloat 1.0 0.0 (Game|Player|IsInputKeyDown :self controller :Key "Up"))))
  (CallFunction|LiftHook :DeltaSeconds step :Axis lift)
  (bind rotate (Utilities|Operators|Subtract (Math|Float|SelectFloat 1.0 0.0 (Game|Player|IsInputKeyDown :self controller :Key "Right")) (Math|Float|SelectFloat 1.0 0.0 (Game|Player|IsInputKeyDown :self controller :Key "Left"))))
  (CallFunction|RotateUpper :DeltaSeconds step :Axis rotate)
  (if (Game|Player|IsInputKeyDown :self controller :Key "RightMouseButton")
    (bind (mouseX mouseY) (Game|Player|GetInputMouseDelta :self controller))
    (CallFunction|OrbitCamera :MouseX mouseX :MouseY mouseY))
  (bind scroll (Game|Player|GetInputAnalogKeyState :self controller :Key "MouseWheelAxis"))
  (CallFunction|ZoomCamera :Change (Utilities|Operators|Multiply scroll -250.0))))